<Window x:Class="Sonda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Sonda.UI"
        Title="Sonda — spazio su disco" Height="900" Width="1440" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="Resources/icon.ico">

    <Window.Resources>
        <!-- Menu contestuale condiviso dalle righe di file/cartelle -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Apri in Esplora risorse" Click="RowOpen_Click" FontWeight="SemiBold"/>
            <MenuItem Header="Mostra nella cartella" Click="RowReveal_Click"/>
            <MenuItem Header="Entra nella cartella (in Sonda)" Click="RowEnter_Click"/>
            <MenuItem Header="Copia percorso" Click="RowCopy_Click"/>
            <MenuItem Header="Proprietà" Click="RowProps_Click"/>
            <Separator/>
            <MenuItem Header="Elimina (nel Cestino)…" Click="RowDelete_Click"/>
        </ContextMenu>

        <Style x:Key="RowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
            <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"/>
        </Style>

        <!-- Colonne riutilizzate -->
        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"
                           Foreground="{Binding Family, Converter={StaticResource FamilyBrush}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BarCell">
            <Grid Width="110" Height="14" Margin="0,0,4,0">
                <Border Background="{StaticResource BarTrackBrush}" CornerRadius="3"/>
                <Border HorizontalAlignment="Left" CornerRadius="3"
                        Background="{Binding Family, Converter={StaticResource FamilyBrush}}"
                        Width="{Binding Share, Converter={StaticResource ShareWidth}, ConverterParameter=110}"/>
                <TextBlock Text="{Binding ShareText}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding OnDiskText}" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,0,6,0"/>
        </DataTemplate>
        <DataTemplate x:Key="LogicalCell">
            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{StaticResource Ink2Brush}" Margin="0,0,6,0"/>
        </DataTemplate>
        <DataTemplate x:Key="FilesCell">
            <TextBlock Text="{Binding FilesText}" HorizontalAlignment="Right" Foreground="{StaticResource Ink2Brush}" Margin="0,0,6,0"/>
        </DataTemplate>
        <DataTemplate x:Key="SafetyCell">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="2,0,6,0" Fill="{Binding Safety, Converter={StaticResource SafetyBrush}}"/>
                <TextBlock Text="{Binding Safety, Converter={StaticResource SafetyLabel}}" Foreground="{StaticResource Ink2Brush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ================= Intestazione ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="Resources/icon.ico" Width="26" Height="26" Margin="0,0,10,0"/>
                    <TextBlock Text="Sonda" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                </StackPanel>

                <ComboBox x:Name="DriveBox" Grid.Column="1" Width="230" Margin="0,0,8,0" DisplayMemberPath="Display" SelectionChanged="DriveBox_SelectionChanged"/>
                <Button Grid.Column="2" Content="Cartella…" Click="PickFolder_Click" Margin="0,0,8,0" ToolTip="Analizza una sola cartella invece dell'intero disco"/>
                <Button x:Name="ScanButton" Grid.Column="3" Content="Analizza" Style="{StaticResource PrimaryButton}" Click="Scan_Click" MinWidth="110"/>

                <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" Margin="18,0,12,0">
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" Text="Scegli il disco e premi Analizza."/>
                    <TextBlock x:Name="ProgressPath" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ElevateButton" Content="Riavvia come amministratore" Click="Elevate_Click" Margin="0,0,8,0"
                            ToolTip="Per leggere System Volume Information, gli altri profili e le copie shadow"/>
                    <Button x:Name="ExportButton" Content="Esporta ▾" Click="Export_Click" IsEnabled="False">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rapporto completo (testo)…" Click="ExportText_Click"/>
                                <MenuItem Header="File più grandi (CSV)…" Click="ExportFilesCsv_Click"/>
                                <MenuItem Header="Cartelle (CSV)…" Click="ExportDirsCsv_Click"/>
                                <MenuItem Header="Cause (CSV)…" Click="ExportCausesCsv_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Barra del volume ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8,16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VolumeText" Text="" FontSize="13"/>
                    <TextBlock x:Name="VolumeRight" Grid.Column="1" Style="{StaticResource Muted}" Text=""/>
                </Grid>
                <Grid Grid.Row="1" Height="12" Margin="0,6,0,0" x:Name="VolumeBarHost">
                    <Border Background="{StaticResource FreeBrush}" CornerRadius="3"/>
                    <Border x:Name="VolumeUsedBar" HorizontalAlignment="Left" Background="{StaticResource UsedBrush}" CornerRadius="3" Width="0"/>
                    <Border x:Name="VolumeSeenBar" HorizontalAlignment="Left" Background="#1C5CAB" CornerRadius="3" Width="0" Height="4" VerticalAlignment="Bottom"
                            ToolTip="Parte dello spazio usato che la scansione ha attribuito a file"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= Avviso amministratore ================= -->
        <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="{StaticResource WarnBgBrush}" BorderBrush="#F0DFA8" BorderThickness="0,0,0,1" Padding="16,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarnFgBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="AdminBannerText" Foreground="{StaticResource WarnFgBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Non sei amministratore: System Volume Information (punti di ripristino), i profili degli altri utenti e alcune cartelle di sistema non si possono leggere. Il loro spazio comparirà come 'non attribuito'."/>
                <Button Content="Riavvia come amministratore" Style="{StaticResource LinkButton}" Click="Elevate_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= Barra di stato ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12" Text="Pronto."/>
                <TextBlock x:Name="StatusRight" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Text=""/>
            </Grid>
        </Border>

        <!-- ================= Corpo ================= -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Colonna sinistra: cause -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Causa principale" Style="{StaticResource Eyebrow}" Margin="2,0,0,6"/>
                    <Border x:Name="MainCauseCard" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonUp="MainCause_Click">
                        <StackPanel x:Name="MainCausePanel">
                            <TextBlock x:Name="NoDataText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Qui comparirà la voce che occupa più spazio, con la spiegazione di cos'è e di come liberarlo."/>
                            <StackPanel x:Name="MainCauseContent" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="3" x:Name="MainCauseSwatch" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MainCauseName" Style="{StaticResource H2}" TextWrapping="Wrap" TextTrimming="None"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="MainCauseSize" Style="{StaticResource Hero}"/>
                                    <TextBlock x:Name="MainCauseShare" Style="{StaticResource Muted}" FontSize="15" VerticalAlignment="Bottom" Margin="10,0,0,7"/>
                                </StackPanel>
                                <Grid Height="10" Margin="0,4,0,8">
                                    <Border Background="{StaticResource BarTrackBrush}" CornerRadius="3"/>
                                    <Border x:Name="MainCauseBar" HorizontalAlignment="Left" CornerRadius="3" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="MainCauseFiles" Style="{StaticResource Muted}" FontSize="12"/>
                                <ContentControl x:Name="MainCauseSafety" ContentTemplate="{StaticResource SafetyChip}" Margin="0,8,0,0"/>
                                <TextBlock Text="Cos'è" Style="{StaticResource Eyebrow}" Margin="0,12,0,2"/>
                                <TextBlock x:Name="MainCauseDesc" TextWrapping="Wrap" TextTrimming="None"/>
                                <TextBlock Text="Come liberare spazio" Style="{StaticResource Eyebrow}" Margin="0,10,0,2"/>
                                <TextBlock x:Name="MainCauseAction" TextWrapping="Wrap" TextTrimming="None"/>
                                <TextBlock Text="Pesano di più" Style="{StaticResource Eyebrow}" Margin="0,10,0,2"/>
                                <ItemsControl x:Name="MainCauseGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource LinkButton}" Click="GroupLink_Click" Tag="{Binding}" HorizontalAlignment="Left" ToolTip="{Binding Path}">
                                                    <TextBlock Text="{Binding ShortPath}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="{Binding OnDiskText}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Vedi tutto il dettaglio" Margin="0,10,0,0" HorizontalAlignment="Left" Click="MainCause_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Altre cause, in ordine di peso" Style="{StaticResource Eyebrow}" Margin="2,16,0,6"/>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <ItemsControl x:Name="OtherCauses">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Click="Cause_Click" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
                                        <Border x:Name="rowB" Padding="8,6" CornerRadius="6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Rank}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OnDiskText}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding ShareText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" MinWidth="36" TextAlignment="Right"/>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="6" Margin="0,4,0,0">
                                                    <Border Background="{StaticResource BarTrackBrush}" CornerRadius="3"/>
                                                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="{Binding Family, Converter={StaticResource FamilyBrush}}"
                                                            Width="{Binding BarShare, Converter={StaticResource ShareWidth}, ConverterParameter=250}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Button.ToolTip>
                                            <TextBlock MaxWidth="360" TextWrapping="Wrap">
                                                <Run Text="{Binding Description, Mode=OneWay}"/><LineBreak/><LineBreak/>
                                                <Run Text="{Binding Action, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="Legenda" Style="{StaticResource Eyebrow}" Margin="2,16,0,6"/>
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel>
                            <WrapPanel x:Name="LegendPanel"/>
                            <Separator Margin="0,8" Background="{StaticResource LineBrush}"/>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,14,2"><Ellipse Width="8" Height="8" Fill="{StaticResource SafeDeletableBrush}" Margin="0,0,5,0"/><TextBlock Text="Eliminabile" FontSize="12" Foreground="{StaticResource Ink2Brush}"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,14,2"><Ellipse Width="8" Height="8" Fill="{StaticResource SafeReviewBrush}" Margin="0,0,5,0"/><TextBlock Text="Da valutare" FontSize="12" Foreground="{StaticResource Ink2Brush}"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,14,2"><Ellipse Width="8" Height="8" Fill="{StaticResource SafeKeepBrush}" Margin="0,0,5,0"/><TextBlock Text="Non toccare" FontSize="12" Foreground="{StaticResource Ink2Brush}"/></StackPanel>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Le dimensioni sono 'su disco' (spazio davvero occupato, arrotondato al cluster; i file compressi e quelli solo online del cloud contano per quello che occupano)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Colonna destra: schede -->
            <TabControl x:Name="Tabs" Grid.Column="2">

                <!-- Cartelle -->
                <TabItem Header="Cartelle">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="240" MinHeight="80"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BackButton" Content="" FontFamily="Segoe MDL2 Assets" Padding="8,4" MinHeight="26" Click="Back_Click" ToolTip="Indietro" Margin="0,0,4,0"/>
                                <Button x:Name="UpButton" Content="" FontFamily="Segoe MDL2 Assets" Padding="8,4" MinHeight="26" Click="Up_Click" ToolTip="Cartella superiore" Margin="0,0,8,0"/>
                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                    <StackPanel x:Name="Breadcrumb" Orientation="Horizontal"/>
                                </ScrollViewer>
                                <TextBlock x:Name="DirSummary" Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
                                <Button Grid.Column="4" Content="Apri in Esplora risorse" Click="OpenCurrent_Click" Padding="10,3" MinHeight="26"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="DirList" Grid.Row="1" ItemContainerStyle="{StaticResource RowItemStyle}" SelectionChanged="DirList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nome" Width="300" CellTemplate="{StaticResource NameCell}" ui:GridViewSort.PropertyName="Name"/>
                                    <GridViewColumn Header="Su disco" Width="100" CellTemplate="{StaticResource SizeCell}" ui:GridViewSort.PropertyName="OnDisk"/>
                                    <GridViewColumn Header="Quota" Width="120" CellTemplate="{StaticResource BarCell}" ui:GridViewSort.PropertyName="Share"/>
                                    <GridViewColumn Header="File" Width="80" CellTemplate="{StaticResource FilesCell}" ui:GridViewSort.PropertyName="Files"/>
                                    <GridViewColumn Header="Tipo" Width="120" DisplayMemberBinding="{Binding TypeLabel}" ui:GridViewSort.PropertyName="TypeLabel"/>
                                    <GridViewColumn Header="Categoria" Width="200" DisplayMemberBinding="{Binding CategoryName}" ui:GridViewSort.PropertyName="CategoryName"/>
                                    <GridViewColumn Header="Sicurezza" Width="110" CellTemplate="{StaticResource SafetyCell}" ui:GridViewSort.PropertyName="Safety"/>
                                    <GridViewColumn Header="Modificato" Width="125" DisplayMemberBinding="{Binding ModifiedText}" ui:GridViewSort.PropertyName="Modified"/>
                                    <GridViewColumn Header="Dimensione" Width="100" CellTemplate="{StaticResource LogicalCell}" ui:GridViewSort.PropertyName="Size"/>
                                    <GridViewColumn Header="Note" Width="260" DisplayMemberBinding="{Binding Note}" ui:GridViewSort.PropertyName="Note"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"/>

                        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="8,4">
                                    <TextBlock Text="Mappa della cartella  ·  ogni rettangolo è proporzionale allo spazio; clic per selezionare, doppio clic per entrare" Style="{StaticResource Muted}" FontSize="11.5"/>
                                </Grid>
                                <ui:TreemapControl x:Name="Treemap" Grid.Row="1" Margin="4,0,4,4"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- File più grandi -->
                <TabItem Header="File più grandi">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Filtra:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}"/>
                            <TextBox x:Name="FileFilter" Grid.Column="1" TextChanged="FileFilter_TextChanged" ToolTip="Cerca nel nome o nel percorso"/>
                            <ComboBox x:Name="FileCatFilter" Grid.Column="2" Width="260" Margin="8,0,0,0" SelectionChanged="FileFilter_TextChanged"/>
                            <TextBlock x:Name="FilesSummary" Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
                            <Button Grid.Column="4" Content="Elimina selezionati (Cestino)…" Click="DeleteSelectedFiles_Click"/>
                        </Grid>
                        <ListView x:Name="FileList" Grid.Row="1" ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Extended">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nome" Width="260" CellTemplate="{StaticResource NameCell}" ui:GridViewSort.PropertyName="Name"/>
                                    <GridViewColumn Header="Su disco" Width="95" CellTemplate="{StaticResource SizeCell}" ui:GridViewSort.PropertyName="OnDisk"/>
                                    <GridViewColumn Header="Cartella" Width="330" DisplayMemberBinding="{Binding Folder}" ui:GridViewSort.PropertyName="Folder"/>
                                    <GridViewColumn Header="Cos'è" Width="210" DisplayMemberBinding="{Binding What}" ui:GridViewSort.PropertyName="What"/>
                                    <GridViewColumn Header="Categoria (causa)" Width="200" DisplayMemberBinding="{Binding CategoryName}" ui:GridViewSort.PropertyName="CategoryName"/>
                                    <GridViewColumn Header="Sicurezza" Width="110" CellTemplate="{StaticResource SafetyCell}" ui:GridViewSort.PropertyName="Safety"/>
                                    <GridViewColumn Header="Modificato" Width="125" DisplayMemberBinding="{Binding ModifiedText}" ui:GridViewSort.PropertyName="Modified"/>
                                    <GridViewColumn Header="Note" Width="200" DisplayMemberBinding="{Binding Note}" ui:GridViewSort.PropertyName="Note"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Dettaglio causa -->
                <TabItem Header="Dettaglio causa" x:Name="CauseTab">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CausePicker" Width="300" VerticalAlignment="Top" DisplayMemberPath="Name" SelectionChanged="CausePicker_SelectionChanged" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CauseSize" Style="{StaticResource H1}"/>
                                        <TextBlock x:Name="CauseShare" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                                        <ContentControl x:Name="CauseSafety" ContentTemplate="{StaticResource SafetyChip}" Margin="14,0,0,3" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CauseDesc" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="CauseAction" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" Foreground="{StaticResource Ink2Brush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Row="1">
                            <TextBlock DockPanel.Dock="Top" Text="Cartelle che pesano di più in questa causa  ·  doppio clic per entrare" Style="{StaticResource Eyebrow}" Margin="2,0,0,4"/>
                            <ListView x:Name="GroupList" MouseDoubleClick="GroupList_DoubleClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Cartella" Width="560" DisplayMemberBinding="{Binding Path}" ui:GridViewSort.PropertyName="Path"/>
                                        <GridViewColumn Header="Su disco" Width="100" CellTemplate="{StaticResource SizeCell}" ui:GridViewSort.PropertyName="OnDisk"/>
                                        <GridViewColumn Header="Quota causa" Width="120" ui:GridViewSort.PropertyName="Share">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Width="110" Height="14">
                                                        <Border Background="{StaticResource BarTrackBrush}" CornerRadius="3"/>
                                                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource AccentBrush}" Width="{Binding Share, Converter={StaticResource ShareWidth}, ConverterParameter=110}"/>
                                                        <TextBlock Text="{Binding ShareText}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="File" Width="90" CellTemplate="{StaticResource FilesCell}" ui:GridViewSort.PropertyName="Files"/>
                                        <GridViewColumn Header="Note" Width="160" DisplayMemberBinding="{Binding Note}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
                        <DockPanel Grid.Row="3">
                            <TextBlock DockPanel.Dock="Top" Text="File più grandi in questa causa" Style="{StaticResource Eyebrow}" Margin="2,4,0,4"/>
                            <ListView x:Name="CauseFileList" ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Extended">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nome" Width="280" CellTemplate="{StaticResource NameCell}" ui:GridViewSort.PropertyName="Name"/>
                                        <GridViewColumn Header="Su disco" Width="100" CellTemplate="{StaticResource SizeCell}" ui:GridViewSort.PropertyName="OnDisk"/>
                                        <GridViewColumn Header="Cos'è" Width="230" DisplayMemberBinding="{Binding What}" ui:GridViewSort.PropertyName="What"/>
                                        <GridViewColumn Header="Cartella" Width="420" DisplayMemberBinding="{Binding Folder}" ui:GridViewSort.PropertyName="Folder"/>
                                        <GridViewColumn Header="Modificato" Width="125" DisplayMemberBinding="{Binding ModifiedText}" ui:GridViewSort.PropertyName="Modified"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- Tipi di file -->
                <TabItem Header="Tipi di file">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Cosa sono i file che occupano spazio, indipendentemente da dove stanno. Doppio clic su un tipo per vedere i suoi file più grandi." Style="{StaticResource Muted}" Margin="2,0,0,8"/>
                        <ListView x:Name="TypeList" Grid.Row="1" MouseDoubleClick="TypeList_DoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Tipo" Width="220" DisplayMemberBinding="{Binding Label}" ui:GridViewSort.PropertyName="Label"/>
                                    <GridViewColumn Header="Su disco" Width="100" CellTemplate="{StaticResource SizeCell}" ui:GridViewSort.PropertyName="OnDisk"/>
                                    <GridViewColumn Header="Quota" Width="120" ui:GridViewSort.PropertyName="Share">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="110" Height="14">
                                                    <Border Background="{StaticResource BarTrackBrush}" CornerRadius="3"/>
                                                    <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource AccentBrush}" Width="{Binding Share, Converter={StaticResource ShareWidth}, ConverterParameter=110}"/>
                                                    <TextBlock Text="{Binding ShareText}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="File" Width="100" CellTemplate="{StaticResource FilesCell}" ui:GridViewSort.PropertyName="Files"/>
                                    <GridViewColumn Header="Descrizione" Width="330" DisplayMemberBinding="{Binding Detail}"/>
                                    <GridViewColumn Header="Estensioni più pesanti" Width="300" DisplayMemberBinding="{Binding Extensions}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Bilancio -->
                <TabItem Header="Bilancio">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="2,0,0,8"
                                   Text="Il conto della serva: lo spazio che Windows dice 'usato' contro quello che la scansione ha trovato. La differenza dice quanto sta in posti non leggibili (punti di ripristino, altri profili) o in metadati."/>
                        <ListView x:Name="BalanceList" Grid.Row="1" MaxHeight="360">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="FontWeight" Value="{Binding Weight}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Voce" Width="300" DisplayMemberBinding="{Binding Label}"/>
                                    <GridViewColumn Header="Byte" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding BytesText}" HorizontalAlignment="Right" Margin="0,0,6,0"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Spiegazione" Width="900">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Note}" TextWrapping="Wrap" MaxWidth="880"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Top" x:Name="DeniedHeader" Text="Cartelle non accessibili" Style="{StaticResource Eyebrow}" Margin="2,0,0,4"/>
                            <ListView x:Name="DeniedList" ItemContainerStyle="{StaticResource RowItemStyle}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Percorso" Width="700" DisplayMemberBinding="{Binding Path}"/>
                                        <GridViewColumn Header="Categoria" Width="240" DisplayMemberBinding="{Binding CategoryName}"/>
                                        <GridViewColumn Header="Note" Width="300" DisplayMemberBinding="{Binding Note}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>

